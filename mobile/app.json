{
  "expo": {
    "name": "Teach",
    "slug": "teach",
    "scheme": "teach",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.teach.mobile",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "app.teach.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#1C4634",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF6EE",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0F1B15"
          }
        }
      ],
      "expo-web-browser",
      "expo-localization",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Teach использует микрофон, чтобы вы могли отвечать голосом.",
          "speechRecognitionPermission": "Teach распознаёт речь, чтобы превратить ответ в текст.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
